# Enable one provider block at a time. Provider can be:
# openai, deepseek, minimax, xiaomi/mimo, or any OpenAI-compatible endpoint.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# DeepSeek example:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_key
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high

# MiniMax example:
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=your_minimax_key
# LLM_MODEL=MiniMax-M2.7
# LLM_BASE_URL=https://api.minimax.io/v1
# MINIMAX_REASONING_SPLIT=false

# Xiaomi MiMo example:
# LLM_PROVIDER=xiaomi
# MIMO_API_KEY=your_mimo_key
# LLM_MODEL=mimo-v2.5-pro
# LLM_BASE_URL=https://api.xiaomimimo.com/v1

# Xiaomi MiMo alias also works:
# LLM_PROVIDER=mimo
# XIAOMI_API_KEY=your_mimo_key

# OpenAI-compatible legacy env vars are still supported:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
